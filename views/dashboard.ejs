<% layout("/layouts/boilerplate") %>

<div class="container text-center mt-5">
    <h1 class="display-4 fw-bold text-dark">Welcome to Your Dashboard</h1>
    <p class="lead text-muted">Explore and manage your listings effortlessly.</p>

    <div class="mt-4">
        <a href="/listings" class="btn btn-lg view-btn">
            <i class="fas fa-list"></i> View Listings
        </a>
    </div>

    <div class="row mt-5 justify-content-center">
        <div class="col-md-4">
            <div class="card dashboard-card shadow-lg border-0">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">Create a New Listing</h5>
                    <p class="card-text text-muted">Start adding new properties easily.</p>
                    <a href="/listings/new" class="btn action-btn">Create</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card dashboard-card shadow-lg border-0">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">Manage Your Listings</h5>
                    <p class="card-text text-muted">Update or remove existing listings.</p>
                    <a href="/listings" class="btn action-btn">Manage</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
    }

    .view-btn {
        background-color: #ff385c;
        color: #fff;
        padding: 12px 25px;
        font-size: 1.2rem;
        border-radius: 8px;
        transition: 0.3s;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    }

    .view-btn:hover {
        background-color: #e22e4f;
        transform: translateY(-2px);
        box-shadow: 0px 6px 15px rgba(0, 0, 0, 0.15);
    }

    .dashboard-card {
    background: white;
    border-radius: 12px;
    padding: 30px; /* Increased padding for better spacing */
    transition: 0.3s;
    box-shadow: 0px 10px 20px rgba(0, 0, 0, 0.15);
}

.dashboard-card:hover {
    transform: translateY(-5px);
    box-shadow: 0px 15px 25px rgba(0, 0, 0, 0.2);
}


    .action-btn {
        background-color: #ff385c;
        color: white;
        padding: 10px 20px;
        border-radius: 6px;
        font-size: 1rem;
        transition: 0.3s;
    }

    .action-btn:hover {
        background-color: #e22e4f;
        transform: translateY(-2px);
    }
</style>
