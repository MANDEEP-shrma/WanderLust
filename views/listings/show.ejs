<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
  <div class="col-8 offset-3">
    <h3><b><%= showDetails.title %></b></h3>
  </div>
  <div class="col-6 offset-3">
    <div class="card show-card listing-card">
      <img src="<%= showDetails.image.url %>" class="card-img-top show-img" alt="Listing Image" />
    </div>
    <div class="card-body">
      <p class="card-text">
        <b>Owned By: 
          <% if (showDetails.owner && showDetails.owner.username) { %>
            <%= showDetails.owner.username %>
          <% } else { %>
            WanderLustUser
          <% } %>
        </b><br /><br />
        <%= showDetails.description %><br /><br />
        &#8377;<%= showDetails.price.toLocaleString("en-IN") %>/per night<br /><br />
        <%= showDetails.location %><br /><br />
        <%= showDetails.country %>
      </p>
    </div>
  </div>
  

  <% if (currUser && showDetails.owner && currUser._id.equals(showDetails.owner._id)) { %>
    <div class="btns">
      <a href="/listings/<%= showDetails._id %>/edit" class="btn edit-btn">Edit</a>
      <form action="/listings/<%= showDetails._id %>?_method=DELETE" method="post">
        <button class="btn edit-btn">Remove</button>
      </form>
    </div>
  <% } %>
  
  <% if (currUser) { %>
  <div class="col-8 offset-3 mt-3 mb-3">
    <hr />
    <h3>Leave a Review</h3>
    <form action="/listings/<%= showDetails._id %>/reviews" method="post" novalidate class="needs-validation">
      <div class="mt-3 mb-3">
        <label for="rating">Rate 1 to 5</label>
        <fieldset class="starability-heart">
          <% for (let i = 1; i <= 5; i++) { %>
            <input type="radio" id="rate<%= i %>" name="review[ratings]" value="<%= i %>" <%= i === 1 ? 'checked' : '' %> />
            <label for="rate<%= i %>" title="<%= i %> Star"><%= i %> star</label>
          <% } %>
        </fieldset>
      </div>
      
      <div>
        <label for="comment">Comment</label>
        <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control" required></textarea>
        <div class="valid-feedback">Looks good!</div>
        <div class="invalid-feedback">Please write a review.</div>
      </div>
      <br />
      <button class="btn btn-outline-danger">Submit</button>
    </form>
  </div>
  <% } %>

  <% if (showDetails.review.length > 0) { %>
  <div class="col-8 offset-3 mt-3 mb-3">
    <hr />
    <h4>All Reviews</h4>
    <div class="row">
      <% for (let review of showDetails.review) { %>
      <div class="card col-5 mb-3 ms-3">
        <div class="card-body">
          <h5 class="card-title mt-2"><%= review.author.username %></h5>
          <hr />
          <p class="starability-result card-text" data-rating="<%= review.ratings %>"></p>
          <p class="card-text"><%= review.comment %></p>
        </div>
        <% if (currUser && review.author._id.equals(currUser._id)) { %>
        <form action="/listings/<%= showDetails._id %>/reviews/<%= review._id %>?_method=DELETE" class="mb-3 mt-1" method="POST">
          <button class="btn btn-sm btn-dark">Delete</button>
        </form>
        <% } %>
      </div>
      <% } %>
    </div>
  </div>
  <% } %>

  <div class="col-8 offset-3 mt-3 mb-3">
    <h3>Where You'll Be</h3>
    <div id="map" style="height: 400px;"></div>
  </div>
</div>

<script>
  window.addEventListener("load", function () {
     const showDetails = <%- JSON.stringify(showDetails) %>;

    console.log(showDetails)

    if (!showDetails || !showDetails.geometry || !showDetails.geometry.coordinates) {
      console.error("Invalid showDetails data:", showDetails);
      return;
    }

    const coordinates = showDetails.geometry.coordinates.reverse(); // Reverse to [lat, lng]

    const map = L.map('map').setView(coordinates, 11);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    L.marker(coordinates)
      .addTo(map)
      .bindPopup(`<h4>${showDetails.title}</h4><p>Exact location will be provided after booking</p>`)
      .openPopup();
  });
</script>
